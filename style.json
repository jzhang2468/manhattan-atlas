{
  "version": 8,
  "name": "Manhattan Atlas",
  "metadata": {
    "maputnik:renderer": "mlgljs",
    "maputnik:owner": "jzhang2468",
    "project:title": "Manhattan Atlas",
    "project:purpose": "A basemap for the Manhattan bike-lane and Central Park squirrel-sighting maps.",
    "style:template": "Positron (OpenMapTiles), selected from the Maputnik gallery",
    "style:template-url": "https://github.com/openmaptiles/positron-gl-style",
    "style:tiles": "OpenFreeMap / OpenMapTiles / OpenStreetMap contributors",
    "style:design": "Cool gray land, slate-blue water, muted teal parks, white streets, and slate labels.",
    "style:initial-view": "Manhattan, centered on Central Park at zoom 12.5",
    "style:created": "2026-11-05"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef2f5"
      },
      "layout": {}
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": [
        "==",
        "$type",
        "Polygon"
      ],
      "layout": {
        "visibility": "visible"
      },
      "paint": {"fill-color": "#c6ddd6"}
    },
    {
      "id": "landcover_ice_shelf",
